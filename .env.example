# =====================================================================
# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
# Los comandos para generar cada secreto están al lado de cada uno.
# =====================================================================

# ---- Contraseñas de la base ----
# Generá cada una con: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR
APP_DB_PASSWORD=CAMBIAR
WORKER_DB_PASSWORD=CAMBIAR

# ---- Secretos de la aplicación ----
# openssl rand -base64 32
AUTH_SECRET=CAMBIAR

# CLAVE DE CIFRADO DE LAS SESIONES DE WHATSAPP.
# openssl rand -base64 32   (tiene que dar exactamente 32 bytes)
# ⚠ Si perdés esta clave, todos los clientes tienen que volver a escanear
#   el QR. Guardala también fuera del servidor.
SESSION_ENC_KEY=CAMBIAR

# ---- Secretos internos entre servicios ----
# openssl rand -hex 32
WORKER_SECRET=CAMBIAR
INGEST_SECRET=CAMBIAR

# ---- IA ----
# Estas son las claves DE LA PLATAFORMA: se usan solo si un consultorio no
# cargó la suya propia desde el panel (Asistente IA). Podés dejarlas vacías
# si cada cliente trae su clave.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Dominio (para el certificado TLS automático de Caddy) ----
DOMAIN=crm.tudominio.com

# ---- Backups a object storage (Cloudflare R2, Backblaze B2, etc.) ----
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_BUCKET=crm-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=

# NO definir APP_BASE_URL. El host sale del request.
